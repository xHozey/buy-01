# Copy to .env and replace local credentials before starting Jenkins.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=replace-with-a-long-random-password

# Backend integration-test settings.
JWT_SECRET=replace-with-at-least-32-random-characters
MONGODB_URI=mongodb://127.0.0.1:27017/buy01-ci
CLOUDINARY_API_KEY=ci-only
CLOUDINARY_API_SECRET=ci-only
SERVER_SSL_KEY_STORE_PASSWORD=ci-only-keystore-password

# Email notifications. SMTP credentials stay in the ignored .env file.
CI_EMAIL_TO=recipient@example.com
SMTP_FROM=jenkins@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=jenkins@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
