pipeline {
    agent any

    tools {
        nodejs 'NodeJS 22'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Frontend build') {
            steps {
                dir('frontend') {
                    sh 'node --version && npm --version'
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Frontend unit tests') {
            steps {
                dir('frontend') {
                    sh "npm test -- --watch=false --include='src/app/services/*.spec.ts'"
                }
            }
        }

        stage('Backend build and tests') {
            steps {
                script {
                    def requiredVariables = [
                        'JWT_SECRET',
                        'MONGODB_URI',
                        'CLOUDINARY_API_KEY',
                        'CLOUDINARY_API_SECRET',
                        'SERVER_SSL_KEY_STORE_PASSWORD'
                    ]
                    def missingVariables = requiredVariables.findAll { !env[it]?.trim() }
                    if (missingVariables) {
                        error("Missing Jenkins environment variables: ${missingVariables.join(', ')}. Set them in jenkins/.env.")
                    }

                    withEnv([
                        "JWT_SECRET=${env.JWT_SECRET}",
                        "MONGODB_URI=${env.MONGODB_URI}",
                        "CLOUDINARY_API_KEY=${env.CLOUDINARY_API_KEY}",
                        "CLOUDINARY_API_SECRET=${env.CLOUDINARY_API_SECRET}",
                        "SERVER_SSL_KEY_STORE_PASSWORD=${env.SERVER_SSL_KEY_STORE_PASSWORD}",
                        'SPRING_KAFKA_LISTENER_AUTO_STARTUP=false'
                    ]) {
                        sh '''
                            set -eu
                            for service in server gateway userService productService mediaService; do
                                echo "Building and testing backend/${service}"
                                (cd "backend/${service}" && ./mvnw -B -ntp verify)
                            done
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'backend/**/target/surefire-reports/TEST-*.xml', allowEmptyResults: true
        }
        success {
            archiveArtifacts artifacts: 'frontend/dist/**,backend/*/target/*.jar', allowEmptyArchive: true
        }
    }
}
