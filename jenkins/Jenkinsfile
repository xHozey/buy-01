pipeline {
    agent any

    tools {
        nodejs 'NodeJS 22'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Frontend build') {
            steps {
                dir('frontend') {
                    sh 'node --version && npm --version'
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Frontend unit tests') {
            steps {
                dir('frontend') {
                    sh "npm test -- --watch=false --include='src/app/services/*.spec.ts'"
                }
            }
        }

        stage('Backend build and tests') {
            steps {
                sh '''
                    set -eu
                    : "${JWT_SECRET:?Set JWT_SECRET in jenkins/.env}"
                    : "${MONGODB_URI:?Set MONGODB_URI in jenkins/.env}"
                    : "${CLOUDINARY_API_KEY:?Set CLOUDINARY_API_KEY in jenkins/.env}"
                    : "${CLOUDINARY_API_SECRET:?Set CLOUDINARY_API_SECRET in jenkins/.env}"
                    : "${SERVER_SSL_KEY_STORE_PASSWORD:?Set SERVER_SSL_KEY_STORE_PASSWORD in jenkins/.env}"
                    export SPRING_KAFKA_LISTENER_AUTO_STARTUP=false

                    for service in server gateway userService productService mediaService; do
                        echo "Building and testing backend/${service}"
                        (cd "backend/${service}" && ./mvnw -B -ntp verify)
                    done
                '''
            }
        }
    }

    post {
        always {
            junit testResults: 'backend/**/target/surefire-reports/TEST-*.xml', allowEmptyResults: true
        }
        success {
            archiveArtifacts artifacts: 'frontend/dist/**,backend/*/target/*.jar', allowEmptyArchive: true
            script {
                if (env.CI_EMAIL_TO) {
                    try {
                        emailext(
                            to: env.CI_EMAIL_TO,
                            subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                            body: "Build succeeded.\n\n${env.BUILD_URL}",
                            mimeType: 'text/plain'
                        )
                    } catch (ignored) {
                        echo 'The success notification could not be sent; check the Jenkins SMTP settings.'
                    }
                } else {
                    echo 'Set CI_EMAIL_TO in jenkins/.env to receive build notifications.'
                }
            }
        }
        failure {
            script {
                if (env.CI_EMAIL_TO) {
                    try {
                        emailext(
                            to: env.CI_EMAIL_TO,
                            subject: "FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                            body: "Build failed. Check the Jenkins console output for details.\n\n${env.BUILD_URL}",
                            mimeType: 'text/plain'
                        )
                    } catch (ignored) {
                        echo 'The failure notification could not be sent; check the Jenkins SMTP settings.'
                    }
                } else {
                    echo 'Set CI_EMAIL_TO in jenkins/.env to receive build notifications.'
                }
            }
        }
    }
}
